#!/bin/sh
# Hand established flows to the Octeon offload: fw4's software flowtable plus
# its hardware offload, which kmod-octeon-offload takes through nf_flowtable.
uci -q batch <<-EOT
	set firewall.@defaults[0].flow_offloading='1'
	set firewall.@defaults[0].flow_offloading_hw='1'
	commit firewall
EOT
exit 0
