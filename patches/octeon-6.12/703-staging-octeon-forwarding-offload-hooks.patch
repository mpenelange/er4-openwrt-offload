--- a/drivers/staging/octeon/ethernet-tx.c
+++ b/drivers/staging/octeon/ethernet-tx.c
@@ -714,3 +714,82 @@ void cvm_oct_tx_shutdown(void)
 
 	tasklet_kill(&cvm_oct_tx_cleanup_tasklet);
 }
