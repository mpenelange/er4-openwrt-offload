From: mpenelange <191051681+mpenelange@users.noreply.github.com>
Subject: staging: octeon: hooks for a packet forwarding offload module

Let one module see received packets before the stack does and send a
packet straight from its receive buffer to the PKO output queue, the
way Cavium's SDK driver lets its ipfwd offload engine do. The module
gets its flows from nf_flowtable (hardware offload, through the
indirect flow block API), so nothing here touches shared structures:
no sk_buff or net_device fields, no new config symbols, and without a
module registered the driver behaves as before.

- cvm_oct_offload_register()/_unregister(): one module's receive
  callback, RCU-protected, called from cvm_oct_poll() before
  netif_receive_skb(). It can pass the packet, take the work queue
  entry (after sending it) or take the skb.
- cvm_oct_offload_xmit(): send a work queue entry from its receive
  buffers, under the lock cvm_oct_xmit() holds around its PKO send.
  Packets in flight are capped per port (fwd_queue_depth, 128) in a FAU
  register of their own, so a flow into a slower port can't drain the
  packet pool and make RED drop input on every port.
- cvm_oct_is_offload_port(): whether a netdev is one of our ports.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
--- /dev/null
+++ b/arch/mips/include/asm/octeon/octeon-ethernet-offload.h
@@ -0,0 +1,62 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Packet forwarding offload for the Octeon ethernet driver
+ * (drivers/staging/octeon): lets one module see received packets before
+ * the stack does, and send a packet straight from its receive buffer.
+ * Without a module registered the driver behaves as before.
+ */
+#ifndef __ASM_OCTEON_ETHERNET_OFFLOAD_H
+#define __ASM_OCTEON_ETHERNET_OFFLOAD_H
+
+#include <linux/types.h>
+
+struct module;
+struct net_device;
+struct sk_buff;
+struct cvmx_wqe;
+
+/* What the receive callback did with a packet */
+enum cvm_oct_rx_result {
+	/* Not taken: the driver passes the packet to the stack */
+	CVM_OCT_RX_PASS,
+	/*
+	 * The callback took the work queue entry and its packet buffers
+	 * (it has sent them with cvm_oct_offload_xmit()). The driver
+	 * leaves an skb that shares the work's buffer alone and frees one
+	 * that doesn't.
+	 */
+	CVM_OCT_RX_TAKEN_WORK,
+	/* The callback took the skb; the driver frees the work as usual */
+	CVM_OCT_RX_TAKEN_SKB,
+};
+
+struct cvm_oct_offload_ops {
+	struct module *owner;
+	/*
+	 * Called in NAPI context for every packet received on a port that
+	 * is up, before the stack sees it. @skb shares @work's buffer when
+	 * the packet fits in one.
+	 */
+	enum cvm_oct_rx_result (*rx)(struct net_device *dev,
+				     struct cvmx_wqe *work,
+				     struct sk_buff *skb);
+};
+
+int cvm_oct_offload_register(const struct cvm_oct_offload_ops *ops);
+void cvm_oct_offload_unregister(const struct cvm_oct_offload_ops *ops);
+
+/* True if @dev is a port of this driver (so cvm_oct_offload_xmit() works) */
+bool cvm_oct_is_offload_port(const struct net_device *dev);
+
+/*
+ * Send @work's packet out of @dev from its receive buffers, which the
+ * hardware then returns to the pool; the work queue entry is freed. On
+ * failure (port down or too many packets queued) the work and its buffers
+ * are freed and a negative errno returned. @l3_offset: offset of an IPv4
+ * header in the packet, to have the hardware fill in its TCP/UDP checksum;
+ * 0 sends the packet's checksums as they are.
+ */
+int cvm_oct_offload_xmit(struct net_device *dev, struct cvmx_wqe *work,
+			 int qos, unsigned int l3_offset);
+
+#endif /* __ASM_OCTEON_ETHERNET_OFFLOAD_H */
--- a/drivers/staging/octeon/ethernet.c
+++ b/drivers/staging/octeon/ethernet.c
@@ -192,6 +192,69 @@ int cvm_oct_free_work(void *work_queue_e
 }
 EXPORT_SYMBOL(cvm_oct_free_work);
 
+#ifdef CONFIG_CAVIUM_OCTEON_SOC
+/* The forwarding offload module's callbacks, if one is registered */
+static const struct cvm_oct_offload_ops __rcu *cvm_oct_offload;
+static DEFINE_MUTEX(cvm_oct_offload_lock);
+
+int cvm_oct_offload_register(const struct cvm_oct_offload_ops *ops)
+{
+	int ret = 0;
+
+	mutex_lock(&cvm_oct_offload_lock);
+	if (rcu_access_pointer(cvm_oct_offload))
+		ret = -EBUSY;
+	else
+		rcu_assign_pointer(cvm_oct_offload, ops);
+	mutex_unlock(&cvm_oct_offload_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(cvm_oct_offload_register);
+
+void cvm_oct_offload_unregister(const struct cvm_oct_offload_ops *ops)
+{
+	mutex_lock(&cvm_oct_offload_lock);
+	if (rcu_access_pointer(cvm_oct_offload) == ops)
+		RCU_INIT_POINTER(cvm_oct_offload, NULL);
+	mutex_unlock(&cvm_oct_offload_lock);
+	/* No receive callback still running when the module goes away */
+	synchronize_net();
+}
+EXPORT_SYMBOL_GPL(cvm_oct_offload_unregister);
+
+enum cvm_oct_rx_result cvm_oct_offload_rx(struct net_device *dev,
+					  struct cvmx_wqe *work,
+					  struct sk_buff *skb)
+{
+	const struct cvm_oct_offload_ops *ops;
+	enum cvm_oct_rx_result ret = CVM_OCT_RX_PASS;
+
+	rcu_read_lock();
+	ops = rcu_dereference(cvm_oct_offload);
+	if (ops)
+		ret = ops->rx(dev, work, skb);
+	rcu_read_unlock();
+	return ret;
+}
+
+static const struct net_device_ops cvm_oct_npi_netdev_ops;
+static const struct net_device_ops cvm_oct_xaui_netdev_ops;
+static const struct net_device_ops cvm_oct_sgmii_netdev_ops;
+static const struct net_device_ops cvm_oct_spi_netdev_ops;
+static const struct net_device_ops cvm_oct_rgmii_netdev_ops;
+
+bool cvm_oct_is_offload_port(const struct net_device *dev)
+{
+	/* Hardware ports only (not the POW device) */
+	return dev->netdev_ops == &cvm_oct_sgmii_netdev_ops ||
+	       dev->netdev_ops == &cvm_oct_rgmii_netdev_ops ||
+	       dev->netdev_ops == &cvm_oct_xaui_netdev_ops ||
+	       dev->netdev_ops == &cvm_oct_spi_netdev_ops ||
+	       dev->netdev_ops == &cvm_oct_npi_netdev_ops;
+}
+EXPORT_SYMBOL_GPL(cvm_oct_is_offload_port);
+#endif /* CONFIG_CAVIUM_OCTEON_SOC */
+
