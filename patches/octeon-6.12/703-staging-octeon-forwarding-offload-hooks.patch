+#ifdef CONFIG_CAVIUM_OCTEON_SOC
+/*
+ * Packets the offload forwards are sent from their receive buffers, which
+ * come from the FPA packet pool; once the pool runs low, RED drops input on
+ * every port. So a flow forwarded into a slower port must not queue without
+ * limit: cap the packets in flight per port, in the port's own FAU
+ * (priv->fwd_fau), which PKO decrements as each packet goes out.
+ */
+static int fwd_queue_depth = 128;
+module_param(fwd_queue_depth, int, 0644);
+MODULE_PARM_DESC(fwd_queue_depth, "Most packets the forwarding offload may have queued per port");
+
+int cvm_oct_offload_xmit(struct net_device *dev, struct cvmx_wqe *work,
+			 int qos, unsigned int l3_offset)
+{
+	struct octeon_ethernet *priv = netdev_priv(dev);
+	union cvmx_pko_command_word0 pko_command;
+	union cvmx_buf_ptr hw_buffer;
+	unsigned long flags;
+	int ret = 0;
+
+	if (unlikely(!(dev->flags & IFF_UP))) {
+		ret = -ENETDOWN;
+		goto drop;
+	}
+	if (qos < 0 || qos >= cvmx_pko_get_num_queues(priv->port))
+		qos = 0;
+
+	if (unlikely(cvmx_fau_fetch_and_add32(priv->fwd_fau, 1) >=
+		     READ_ONCE(fwd_queue_depth))) {
+		cvmx_fau_atomic_add32(priv->fwd_fau, -1);
+		ret = -ENOBUFS;
+		goto drop;
+	}
+
+	hw_buffer.u64 = 0;
+	hw_buffer.s.addr = work->packet_ptr.s.addr;
+	hw_buffer.s.pool = CVMX_FPA_PACKET_POOL;
+	hw_buffer.s.size = CVMX_FPA_PACKET_POOL_SIZE;
+	hw_buffer.s.back = work->packet_ptr.s.back;
+
+	pko_command.u64 = 0;
+	/* The headers were just rewritten: keep them in L2 */
+	pko_command.s.n2 = 0;
+	pko_command.s.segs = work->word2.s.bufs;
+	pko_command.s.total_bytes = work->word1.len;
+	/* PKO decrements the port's in-flight count once the packet is out */
+	pko_command.s.size0 = CVMX_FAU_OP_SIZE_32;
+	pko_command.s.subone0 = 1;
+	pko_command.s.reg0 = priv->fwd_fau;
+	/* 0 leaves the checksums alone */
+	pko_command.s.ipoffp1 = l3_offset ? l3_offset + 1 : 0;
+
+	/* cvm_oct_xmit() holds this lock around its own PKO send */
+	spin_lock_irqsave(&priv->tx_free_list[qos].lock, flags);
+	cvmx_pko_send_packet_prepare(priv->port, priv->queue + qos,
+				     CVMX_PKO_LOCK_NONE);
+	if (unlikely(cvmx_pko_send_packet_finish(priv->port, priv->queue + qos,
+						 pko_command, hw_buffer,
+						 CVMX_PKO_LOCK_NONE)))
+		ret = -EIO;
+	spin_unlock_irqrestore(&priv->tx_free_list[qos].lock, flags);
+
+	if (unlikely(ret)) {
+		cvmx_fau_atomic_add32(priv->fwd_fau, -1);
+		goto drop;
+	}
+	/* PKO frees the packet buffers; the work queue entry is ours */
+	cvmx_fpa_free(work, CVMX_FPA_WQE_POOL, 1);
+	return 0;
+
+drop:
+	dev->stats.tx_dropped++;
+	cvm_oct_free_work(work);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(cvm_oct_offload_xmit);
+#endif /* CONFIG_CAVIUM_OCTEON_SOC */
